# Copy to backend/.env. Do not commit the filled file.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SYNC_TOKEN=
CORS_ORIGINS=["http://localhost:3000"]
SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
