# Copy to backend/.env. Do not commit the filled file.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SYNC_TOKEN=
CORS_ORIGINS=["http://localhost:3000"]
SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
# Comma-separated email domains for sign-in and sheet rows. Real BTU accounts only.
# Keep any extra test domain on your own machine. Never deploy one, because it would let those
# addresses sign in and be issued passports.
ALLOWED_EMAIL_DOMAINS=btu.edu.ge
# Local demos only: lets the "demo-admin" token into /admin. Leave unset (false) anywhere deployed.
# DEMO_MODE=false
# Serves /docs, /redoc and /openapi.json. Off unless set. Use true on your own machine only.
# ENABLE_API_DOCS=false

# PDF files. Leave unset to store them under backend/var/passports.
# When both Supabase values above are set, files go to the private passports bucket.
# PDF_STORAGE_DIR=

# Polygon Amoy. Leave unset to keep new versions pending.
AMOY_RPC_URL=
ANCHOR_CONTRACT_ADDRESS=
BTU_ISSUER_PRIVATE_KEY=
# Public verify also reads the anchored hash back from the contract (needs AMOY_RPC_URL only).
# ANCHOR_CONTRACT_ADDRESS defaults to the published contract. ONCHAIN_VERIFY=false turns the read off.
# ONCHAIN_VERIFY=true
# ONCHAIN_TIMEOUT_SECONDS=3

# Rate limits (in memory, one-minute window). All optional, these are the defaults.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_VERIFY_PER_MINUTE=30         # POST /verify, per visitor IP
# RATE_LIMIT_FLAGS_PER_MINUTE=5           # POST /flags, per signed-in student
# RATE_LIMIT_ADMIN_WRITES_PER_MINUTE=30   # admin POST/PATCH/DELETE, per admin
# Non-zero = behind Render: trust CF-Connecting-IP (fallback: X-Forwarded-For). 0 (default) ignores them, which
# is right on your own machine. On Render set 3.
# TRUSTED_PROXY_HOPS=0
