# Copy to backend/.env. Do not commit the filled file.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SYNC_TOKEN=
CORS_ORIGINS=["http://localhost:3000"]
SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
# Comma-separated email domains for sign-in and sheet rows.
# The official test sheet uses example.org: btu.edu.ge,example.org
ALLOWED_EMAIL_DOMAINS=btu.edu.ge
# Local demos only: lets the "demo-admin" token into /admin. Leave unset (false) anywhere deployed.
# DEMO_MODE=false
# Serves /docs, /redoc and /openapi.json. Off unless set. Use true on your own machine only.
# ENABLE_API_DOCS=false

# PDF files. Leave unset to store them under backend/var/passports.
# When both Supabase values above are set, files go to the private passports bucket.
# PDF_STORAGE_DIR=

# Polygon Amoy. Leave unset to keep new versions pending.
AMOY_RPC_URL=
ANCHOR_CONTRACT_ADDRESS=
BTU_ISSUER_PRIVATE_KEY=
# Public verify also reads the anchored hash back from the contract (needs AMOY_RPC_URL only).
# ANCHOR_CONTRACT_ADDRESS defaults to the published contract. ONCHAIN_VERIFY=false turns the read off.
# ONCHAIN_VERIFY=true
# ONCHAIN_TIMEOUT_SECONDS=3
